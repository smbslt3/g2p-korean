{
  "schema": "r39_independent_role_refs_v1",
  "frozen_before_any_runtime_execution": true,
  "expectation_origin": "국립국어원 제29항 붙임2의 국소 환경과 독립 작성한 형태소 역할·소유권 계약",
  "source_policy": {
    "allowed": [
      "src/g2p_ko의 기존 공개 모델과 저수준 실행 API",
      "국립국어원 어문 규범"
    ],
    "not_consulted": [
      "기존 tests/fixtures",
      "기존 출력·보고서",
      "외부 G2P 구현",
      "R36/B21",
      "R38/B22",
      "비공개 7개 pool",
      "새 후보 실행 결과"
    ],
    "lexical_table_additions": false
  },
  "normative_sources": [
    {
      "url": "https://korean.go.kr/kornorms/m/m_regltn.do?regltn_code=0002",
      "section": "표준 발음법 제29항 붙임 1·2",
      "access": "공식 검색 색인에서 조문 확인; 직접 열기는 403",
      "use": "이어 읽는 한 마디에서 자음 끝말과 ㅣ·y계 첫머리의 국소 ㄴ 첨가"
    },
    {
      "url": "https://www.korean.go.kr/front/onlineQna/onlineQnaView.do?mn_id=27&pageIndex=1&qna_seq=327019",
      "section": "구의 이어 읽기와 휴지 구분",
      "access": "공식 검색 색인",
      "use": "구 전체의 고정 표준 발음을 주장하지 않고 이어 읽기 조건의 국소 결과만 검사"
    }
  ],
  "interpretation": [
    "이 fixture의 긍정 사례는 예외를 주장하지 않는 통제된 형태소 입력의 프로그램상 이어 읽기 분기 검사다.",
    "파생어 역할 증명은 독립성의 증거이며 모든 자연 발화의 ㄴ 첨가를 강제한다는 뜻은 아니다.",
    "expect_local_right는 형태소 단계 직후 첫 음절이다. 비음화·유음화·전체 완성 발음은 검사하지 않는다.",
    "단어의 어휘 존재성이나 Kiwi 분석 정답률은 평가하지 않는다. 형태소열은 입력 가정으로 명시했다.",
    "소유·태그·범주·휴지·상충 읽기는 별도의 안전 계약이며 국립국어원이 이 내부 API를 정했다는 주장이 아니다."
  ],
